DATABASE_URL=postgres://user:pass@host/db        # Neon or Supabase
APP_SECRET=long-random-string                    # signs OTP tokens, hashes IPs/OTPs
ADMIN_TOKEN=long-random-string                   # admin login for /admin
CRON_SECRET=long-random-string                   # Vercel sends this to the cron route
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx                      # set when creating the webhook in the dashboard
MSG91_AUTHKEY=xxx
MSG91_OTP_TEMPLATE_ID=xxx                        # DLT-approved template
